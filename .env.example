# Copy to .env.local and fill in values. Never commit real keys or passwords.
#
# This project is Create React App — use REACT_APP_* below (not VITE_* / import.meta.env).
# Supabase Vite snippets use VITE_SUPABASE_*; Next.js uses NEXT_PUBLIC_* + @supabase/ssr.

# --- App + /admin (browser) — Project Settings → API ---
REACT_APP_SUPABASE_URL=https://ywpwaeykighnleqwfmns.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT anon key (optional if you use publishable key above)
REACT_APP_SUPABASE_ANON_KEY=

# --- Seed: npm run seed:supabase — service_role key only on your machine / CI ---
SUPABASE_URL=https://ywpwaeykighnleqwfmns.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: direct Postgres (psql, TablePlus, ORM) — not used by this CRA app ---
# If "db.*" is not IPv4-compatible on your network, use Session pooler host/port from the dashboard instead.
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.ywpwaeykighnleqwfmns.supabase.co:5432/postgres
